diff --git a/src/rtl_airband.h b/src/rtl_airband.h
index 8d58112..0444f90 100644
--- a/src/rtl_airband.h
+++ b/src/rtl_airband.h
@@ -181,6 +181,27 @@ struct pulse_data {
     pa_channel_map lmap, rmap;
     mix_modes mode;
     bool continuous;
+    int buffer_ms;  // target stream latency in ms; 0 = server default
+    size_t underflow_count;
+    float latency_ms;  // stream latency measured before the last write (-1 = unknown)
+    // rate matching: the SDR's sample clock and the sound server's clock differ
+    // by tens of ppm, so a continuous stream slowly drains (or fills) and
+    // underflows every few minutes. With rate_match, one sample is added or
+    // dropped (spread over a whole batch by linear interpolation) as needed to
+    // hold the stream latency at the level it settled at after connecting.
+    bool rate_match;
+    int rm_batches;      // batches seen since the stream connected
+    double rm_ema_ms;    // smoothed latency
+    double rm_target_ms; // latency to hold (learned during warm-up)
+    double rm_acc;       // fractional samples owed (+) or surplus (-)
+    double rm_ppm;       // current correction (P + I)
+    double rm_i_ppm;     // integral part: settles at the clocks' real offset
+    size_t rm_inserted, rm_dropped;
+    // production vs consumption, for measuring the real clock offset:
+    unsigned long long written_bytes;  // bytes handed to pa_stream_write (master stream)
+    double written_mono_s;             // CLOCK_MONOTONIC at that write
+    long long read_index;              // server read position from the timing info
+    unsigned long long read_index_usec;  // timing info timestamp (realtime usec)
 };
 #endif /* WITH_PULSEAUDIO */
 
