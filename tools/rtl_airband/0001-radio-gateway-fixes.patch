+    if (pdata->rate_match && len == (size_t)WAVE_BATCH * sizeof(float)) {
+        int d = rm_step(pdata, WAVE_BATCH);
+        if (d != 0) {
+            size_t m = rm_resample(data_left, WAVE_BATCH, rm_left, d);
+            data_left = rm_left;
+            if (mode == MM_STEREO) {
+                rm_resample(data_right, WAVE_BATCH, rm_right, d);
+                data_right = rm_right;
+            }
+            len = m * sizeof(float);
+        }
+    }
     if (!pdata->context || pa_context_get_state(pdata->context) != PA_CONTEXT_READY)
         goto end;
     if (pulse_write_single_stream(pdata->left, pdata, data_left, len, true) < 0)
