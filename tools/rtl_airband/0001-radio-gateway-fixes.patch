                     std::min(len - space_left, 2 * input->bytes_per_sample * fft_size));
     }
 
+    input->sample_count += len / (2 * input->bytes_per_sample);
     size_t old_end = input->bufe;
     input->bufe = (input->bufe + len) % input->buf_size;
