+// --- rate matching -----------------------------------------------------------
+#define RM_WARMUP_BATCHES 80      // 10 s at 8 batches/s: learn the target latency
+#define RM_EMA_ALPHA (1.0 / 160)  // ~20 s smoothing; single readings jitter by tens of ms
+// PI control. Plant: 1 ppm of mismatch moves the latency 0.001 ms/s, so
+// Kp = 10 ppm/ms gives a ~100 s loop, well below the 20 s smoothing.
+// Ki = Kp / 400 s puts the integral zero under the crossover, which keeps the
+// phase margin; the integral removes P-only's offset (it sat 16 ms under the
+// target at a 160 ppm clock offset).
+#define RM_KP_PPM_PER_MS 10.0
+#define RM_KI_PPM_PER_MS_S (RM_KP_PPM_PER_MS / 400.0)
+#define RM_BATCH_S ((double)WAVE_BATCH / (double)WAVE_RATE)
+#define RM_MAX_PPM 1000.0
+// Never hold less than this. PipeWire pulls from the stream one graph cycle at
+// a time (2048 samples = 42.7 ms here); a stream that settled lower after
+// connecting would be held just above underflow, so the loop raises it.
+#define RM_MIN_TARGET_MS 80.0
+
+// Stretch or shrink one batch by d (-1, 0 or +1) samples with a 32-tap
+// Blackman-windowed sinc interpolator (linear was -34 dB clean at 1 kHz, cubic
+// -28 dB at 3 kHz). Only ~1 batch in 8 is touched at typical drift, so the cost
+// is negligible. The first and last samples are kept (fractional offset 0
+// there), so batches still join without a step. Taps past either end of the
+// batch use the edge sample.
+#define RM_HALF_TAPS 16
+static size_t rm_resample(const float* in, size_t n, float* out, int d) {
+    size_t m = n + d;
+    if (d == 0 || n < 2) {
+        memcpy(out, in, n * sizeof(float));
+        return n;
+    }
+    double step = (double)(n - 1) / (double)(m - 1);
+    for (size_t i = 0; i < m; i++) {
+        double pos = i * step;
+        long k = (long)pos;
+        double t = pos - (double)k;
+        if (t < 1e-9) {
+            out[i] = in[k < (long)n ? k : (long)n - 1];
+            continue;
+        }
+        double acc = 0.0, wsum = 0.0;
+        for (long j = -RM_HALF_TAPS + 1; j <= RM_HALF_TAPS; j++) {
+            double x = (double)j - t;  // distance from the wanted position
+            double sinc = sin(M_PI * x) / (M_PI * x);
+            double w = 0.42 + 0.5 * cos(M_PI * x / RM_HALF_TAPS) + 0.08 * cos(2.0 * M_PI * x / RM_HALF_TAPS);
+            long idx = k + j;
+            if (idx < 0)
+                idx = 0;
+            if (idx >= (long)n)
+                idx = (long)n - 1;
+            acc += in[idx] * sinc * w;
+            wsum += sinc * w;
+        }
+        out[i] = (float)(acc / wsum);  // normalise: unity gain at DC
+    }
+    return m;
+}
+
+// Decide this batch's correction from the latency measured before the last write.
+static int rm_step(pulse_data* pdata, size_t n) {
+    if (pdata->latency_ms < 0)
+        return 0;
+    pdata->rm_batches++;
+    if (pdata->rm_batches <= RM_WARMUP_BATCHES) {
+        // running mean: single readings jitter too much to seed an EMA
+        pdata->rm_ema_ms += (pdata->latency_ms - pdata->rm_ema_ms) / pdata->rm_batches;
+        pdata->rm_target_ms = pdata->rm_ema_ms > RM_MIN_TARGET_MS ? pdata->rm_ema_ms : RM_MIN_TARGET_MS;
+        return 0;
+    }
+    pdata->rm_ema_ms += RM_EMA_ALPHA * (pdata->latency_ms - pdata->rm_ema_ms);
+    double err_ms = pdata->rm_target_ms - pdata->rm_ema_ms;
+    double p_ppm = RM_KP_PPM_PER_MS * err_ms;
+    double i_new = pdata->rm_i_ppm + RM_KI_PPM_PER_MS_S * err_ms * RM_BATCH_S;
+    double ppm = p_ppm + i_new;
+    // anti-windup: only integrate while the output is not saturated
+    if (ppm > RM_MAX_PPM)
+        ppm = RM_MAX_PPM;
+    else if (ppm < -RM_MAX_PPM)
+        ppm = -RM_MAX_PPM;
+    else
+        pdata->rm_i_ppm = i_new;
+    pdata->rm_ppm = ppm;
+    pdata->rm_acc += ppm * 1e-6 * (double)n;
+    if (pdata->rm_acc >= 1.0) {
+        pdata->rm_acc -= 1.0;
+        pdata->rm_inserted++;
+        return 1;
+    }
+    if (pdata->rm_acc <= -1.0) {
+        pdata->rm_acc += 1.0;
+        pdata->rm_dropped++;
+        return -1;
+    }
+    return 0;
+}
+
